.venv/

# Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
logs/
*.log

# Environment files
.env
.env.local
settings.json

# WebView2 storage (pywebview port, main_webview.py) - written next to
# whichever app_data_dir the app resolves (repo root when run from
# source, unfrozen; the install folder once built), same category as
# settings.json/logs/ above.
webview_data/

# Editor / OS files
.vscode/
*.swp
Thumbs.db
Desktop.ini

# Distribution / packaging
dist/
build/
*.egg-info/



# Crash artifacts from MSYS/Git-Bash
*.stackdump

# Local-only notes and per-machine editor/agent config: project-scoped but
# never published. Generic patterns on purpose.
*.local.md
